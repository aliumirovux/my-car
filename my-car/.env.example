# Copy to `.env` (git-ignored) and fill in. Only EXPO_PUBLIC_* variables are
# inlined into the app bundle — everything here is readable by anyone who has the APK.
#
# NEVER put the Supabase service-role key (or any other secret) in this app.
# It bypasses Row Level Security; it belongs only on a server / Edge Function.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (a.k.a. publishable) key — safe to ship only when RLS is enabled on every table.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
